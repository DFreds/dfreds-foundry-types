{
    "name": "@dfreds/foundry-types",
    "version": "14.366.0",
    "description": "Type definitions for the Foundry VTT client, versioned to match Foundry itself",
    "type": "module",
    "types": "./index.d.mts",
    "exports": {
        ".": {
            "types": "./index.d.mts"
        },
        "./client/*": {
            "types": "./client/*"
        },
        "./common/*": {
            "types": "./common/*"
        },
        "./tsconfig.base.json": "./tsconfig.base.json"
    },
    "files": [
        "client",
        "common",
        "global-external.d.mts",
        "util.d.mts",
        "index.d.mts",
        "tsconfig.base.json",
        "NOTICE"
    ],
    "keywords": [
        "foundry",
        "foundry-vtt",
        "types",
        "typescript"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "sync": "tsx ./build/sync-types.ts",
        "check": "tsc -p tsconfig.check.json",
        "prepublishOnly": "npm run check",
        "lint": "eslint",
        "lint:fix": "eslint --fix",
        "make-patch": "tsx ./build/make-patch.ts"
    },
    "author": "DFreds",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DFreds/dfreds-foundry-types.git"
    },
    "engines": {
        "node": ">=24.14.1"
    },
    "peerDependencies": {
        "typescript": ">=5.9"
    },
    "dependencies": {
        "@pixi/graphics-smooth": "1.1.1",
        "@pixi/particle-emitter": "5.0.10",
        "@types/jquery": "^3.5.32",
        "@types/node": "^24.2.0",
        "@types/simple-peer": "^9.11.9",
        "handlebars": "4.7.9",
        "js-angusj-clipper": "^1.3.1",
        "pixi.js": "7.4.3",
        "prosemirror-collab": "^1.3.1",
        "prosemirror-commands": "^1.7.1",
        "prosemirror-dropcursor": "^1.8.2",
        "prosemirror-gapcursor": "^1.4.1",
        "prosemirror-history": "^1.5.0",
        "prosemirror-inputrules": "^1.5.1",
        "prosemirror-keymap": "^1.2.3",
        "prosemirror-model": "^1.25.4",
        "prosemirror-schema-list": "^1.5.1",
        "prosemirror-state": "^1.4.4",
        "prosemirror-tables": "^1.8.5",
        "prosemirror-transform": "^1.12.0",
        "prosemirror-view": "^1.41.8",
        "socket.io": "4.8.1",
        "socket.io-client": "4.8.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/fs-extra": "^11.0.4",
        "eslint": "^10.3.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "fs-extra": "^11.3.4",
        "prettier": "^3.8.3",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.59.1"
    },
    "foundryVersion": "14.366",
    "pf2eCommit": "54e70a5288c"
}
